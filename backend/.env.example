# 비우면 인메모리 저장소로 동작한다 (로컬 개발용).
# Supabase 등 Postgres 연결 문자열을 넣으면 DB에 사건이 저장된다.
DATABASE_URL=

# API 서버 포트 (기본 4000)
PORT=4000

# CORS: 아래 둘 중 하나라도 설정하면 해당 규칙으로 제한, 둘 다 비우면(로컬 개발) 전체 허용
# 쉼표로 구분한 허용 오리진 목록 (예: https://life-court.vercel.app)
CORS_ORIGINS=
# 허용 오리진 정규식 (예: https://.*\.vercel\.app)
CORS_ORIGIN_REGEX=
